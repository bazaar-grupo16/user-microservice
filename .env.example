# ──────────────────────────────────────────────────────
# Environment variables for the Bazaar microservice.
# Copy this file to .env and fill in the real values.
# NEVER commit .env with real credentials to the repo.
# ──────────────────────────────────────────────────────

APP_NAME=user-service
LOG_LEVEL=info

# ── Database ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=user_db

# used by the password recovery flow
RESEND_API_KEY=resendapkey

# Google OAuth2 client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=googleclientid.apps.googleusercontent.com
